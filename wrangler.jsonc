{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roblox-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "kv_namespaces": [
    {
      "binding": "MONITOR_KV",
      "id": "dce30623d10f44539533f71ed9332173"
    }
  ]
}
